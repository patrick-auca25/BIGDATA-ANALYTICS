                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "energy",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \n    LPAD(EXTRACT(HOUR FROM time_bucket('1 hour', timestamp))::text, 2, '0') || ':00' AS \"Hour\",\n    ROUND(SUM(CASE WHEN DATE(timestamp) = CURRENT_DATE - 1 THEN energy END)::numeric, 2) AS \"Yesterday\",\n    ROUND(SUM(CASE WHEN DATE(timestamp) = CURRENT_DATE THEN energy END)::numeric, 2) AS \"Today\"\nFROM energy_readings\nWHERE timestamp >= CURRENT_DATE - INTERVAL '1 day'\n  AND timestamp < CURRENT_DATE + INTERVAL '1 day'\nGROUP BY EXTRACT(HOUR FROM time_bucket('1 hour', timestamp))\nORDER BY EXTRACT(HOUR FROM time_bucket('1 hour', timestamp));",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
